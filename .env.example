# Optional server-side model provider. Leave blank for the complete local mode.
# Optional modelling override (preserved):
# BLENDER_BIN=C:/path/to/blender.exe
# Server appends /chat/completions. Never use VITE_ for secrets.
# Official DeepSeek-V4.1-Flash uses model ID deepseek-flash.
# Leave API key/token blank to keep remote execution disabled.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Required shared access passphrase for remote execution; entered in the UI.
LLM_ACCESS_TOKEN=
