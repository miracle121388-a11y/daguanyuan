# Optional server-side model provider. Leave blank for the complete local mode.
# Optional modelling override (preserved):
# BLENDER_BIN=C:/path/to/blender.exe
# Server appends /chat/completions. Never use VITE_ for secrets.
# Official DeepSeek-V4.1-Flash uses model ID deepseek-flash.
# Leave API key/token blank to keep remote execution disabled.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Required shared access passphrase for remote execution; entered in the UI.
LLM_ACCESS_TOKEN=

# Live story illustration. DashScope uses async tasks; other protocols use Images.
# Configure the chosen provider; there is no browser-side image API key.
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_PROTOCOL=dashscope
IMAGE_REFERENCE=true
IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_API_KEY=
# Blank reuses LLM_ACCESS_TOKEN. This is the visitor passphrase, not API key.
IMAGE_ACCESS_TOKEN=
IMAGE_SIZE=1536x1024
# Optional provider-specific parameters; leave blank if unsupported.
IMAGE_QUALITY=
IMAGE_OUTPUT_FORMAT=
IMAGE_RESULT_HOSTS=
IMAGE_DAILY_LIMIT=20
IMAGE_CONCURRENCY=1
IMAGE_TIMEOUT_MS=600000
IMAGE_STORAGE_MB=512
# Mount persistent storage here in production; never put generated art in canon.
DREAM_STORAGE_DIR=.local/dream-art
