{
  "name": "daguanyuan-rumeng",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "doctor": "node scripts/pipeline.mjs doctor",
    "assets:fetch": "python scripts/fetch_assets.py",
    "content:prepare": "python scripts/prepare_content.py && python scripts/prepare_architecture.py",
    "start": "node server.mjs",
    "deploy:package": "python scripts/package_deploy.py",
    "models:build": "node scripts/pipeline.mjs models",
    "models:optimize": "node scripts/optimize.mjs",
    "data:build": "node scripts/validate.mjs --publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --no-warn-ignored",
    "test": "vitest run",
    "verify": "node scripts/validate.mjs",
    "build": "npm run data:build && tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "pipeline": "node scripts/pipeline.mjs all"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.179.1",
    "zod": "4.1.5",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "5.0.2",
    "draco3dgltf": "1.5.7",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
