  "components": [
    {
      "name": "导览主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "底部导览的开始、暂停或继续动作；桌面样式与现有焦点、悬停、禁用状态。",
      "html": "<button class=\"ds-tour-play\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg><span>开始游园</span></button>",
      "css": ".ds-tour-play{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 24px;background:#466345;color:#fff9eb;border:0;border-radius:4px;font:13px \"Microsoft YaHei\",\"PingFang SC\",sans-serif;letter-spacing:1px;white-space:nowrap;cursor:pointer}.ds-tour-play:hover{background:#344f36;color:#fff}.ds-tour-play:disabled{opacity:.5;cursor:not-allowed}.ds-tour-play:focus-visible{outline:2px solid var(--cinnabar,#8b4b34);outline-offset:4px}"
    },
    {
      "name": "场景图标按钮",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "桌面场景工具为 44px 方形；手机最终为 40px × 44px，工具条宽 48px。此预览呈现桌面按钮，基础图标按钮另有较小变体。",
      "html": "<button class=\"ds-scene-icon\" type=\"button\" aria-label=\"回到全园\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg></button>",
      "css": ".ds-scene-icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:3px;background:transparent;color:#343d34;cursor:pointer}.ds-scene-icon:hover,.ds-scene-icon[aria-pressed=true]{background:#e4e8dc;color:var(--jade,#496343)}.ds-scene-icon:focus-visible{outline:2px solid var(--cinnabar,#8b4b34);outline-offset:4px}"
    },
    {
      "name": "底线搜索框",
      "kind": "input",
      "refersTo": "search",
      "description": "地点、人物或回目索引中的桌面搜索；手机输入使用 16px 字号。",
      "html": "<label class=\"ds-search\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"搜索园中内容\" placeholder=\"寻一处园景…\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line,#d4d8c8);padding-bottom:9px;color:#838979;max-width:240px}.ds-search input{width:100%;min-width:0;border:0;background:transparent;color:var(--ink,#28372c);font:14px \"Microsoft YaHei\",\"PingFang SC\",sans-serif;caret-color:var(--cinnabar,#8b4b34)}.ds-search input::placeholder{color:#6e7769}.ds-search input:focus-visible{outline:2px solid var(--cinnabar,#8b4b34);outline-offset:4px}"
    },
    {
      "name": "桌面主导航",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "线性图标和文字，当前项为深绿并有底线；手机另行移至底部且当前没有可见下划线。",
